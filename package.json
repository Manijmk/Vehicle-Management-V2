{
  "name": "vehicle-management-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.12 <23",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "clean": "pnpm -r --if-present run clean",
    "dev": "pnpm --filter \"./packages/**\" build && pnpm --parallel --filter \"./apps/**\" dev",
    "dev:infra": "docker compose up -d postgres redis minio minio-init",
    "dev:infra:down": "docker compose down",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm --filter \"./packages/**\" build && pnpm -r --if-present run typecheck",
    "test": "pnpm --filter \"./packages/**\" build && pnpm -r --if-present run test",
    "test:coverage": "pnpm --filter \"./packages/**\" build && pnpm -r --if-present run test:coverage",
    "test:e2e": "pnpm --filter @vms/web test:e2e",
    "db:format": "pnpm --filter @vms/database db:format",
    "db:generate": "pnpm --filter @vms/database db:generate",
    "db:migrate:dev": "pnpm --filter @vms/database db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @vms/database db:migrate:deploy",
    "db:migrate:status": "pnpm --filter @vms/database db:migrate:status",
    "db:seed": "pnpm --filter @vms/database db:seed",
    "auth:dev-token": "pnpm --filter @vms/api auth:dev-token"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@next/eslint-plugin-next": "16.3.1",
    "@types/node": "24.10.1",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "prettier": "3.9.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1"
  }
}
