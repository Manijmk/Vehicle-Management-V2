  organization  Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  vehicle       Vehicle                  @relation(fields: [vehicleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  driver        Driver?                  @relation(fields: [driverId, organizationId], references: [id, organizationId], onDelete: Restrict)
  trip          Trip?                    @relation(fields: [tripId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdByUser User                     @relation("FuelTransactionCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser User                     @relation("FuelTransactionUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  voidedByUser  User?                    @relation("FuelTransactionVoidedBy", fields: [voidedBy], references: [id], onDelete: Restrict)
  anomalies     FuelTransactionAnomaly[]

  @@unique([organizationId, displayId])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, vehicleId, occurredAt])
  @@index([organizationId, driverId, occurredAt])
  @@index([organizationId, tripId])
  @@index([organizationId, referenceNumber])
  @@index([organizationId, occurredAt])
  @@map("fuel_transactions")
}

model FuelTransactionAnomaly {
  id                String              @id @default(uuid()) @db.Uuid
  organizationId    String              @map("organization_id") @db.Uuid
  fuelTransactionId String              @map("fuel_transaction_id") @db.Uuid
  code              FuelAnomalyCode
  severity          FuelAnomalySeverity @default(WARNING)
  description       String              @db.VarChar(500)
  metadata          Json?
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  fuelTransaction FuelTransaction @relation(fields: [fuelTransactionId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([id, organizationId])
  @@index([organizationId, fuelTransactionId])
  @@index([organizationId, code])
  @@map("fuel_transaction_anomalies")
}

model ExpenseCategory {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  code           String                @db.VarChar(50)
  name           String                @db.VarChar(100)
  description    String?               @db.VarChar(500)
  status         ExpenseCategoryStatus @default(ACTIVE)
  version        Int                   @default(1)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy      String                @map("created_by") @db.Uuid
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy      String                @map("updated_by") @db.Uuid

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdByUser User         @relation("ExpenseCategoryCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser User         @relation("ExpenseCategoryUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  expenses      Expense[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@map("expense_categories")
}

model Expense {
  id                     String        @id @default(uuid()) @db.Uuid
  organizationId         String        @map("organization_id") @db.Uuid
  displayId              String        @map("display_id") @db.VarChar(40)
  categoryId             String        @map("category_id") @db.Uuid
  vehicleId              String?       @map("vehicle_id") @db.Uuid
  driverId               String?       @map("driver_id") @db.Uuid
  tripId                 String?       @map("trip_id") @db.Uuid
  maintenanceWorkOrderId String?       @map("maintenance_work_order_id") @db.Uuid
  occurredAt             DateTime      @map("occurred_at") @db.Timestamptz(3)
  description            String        @db.VarChar(500)
  amount                 Decimal       @db.Decimal(12, 2)
  currencyCode           String        @map("currency_code") @db.VarChar(3)
  vendorName             String?       @map("vendor_name") @db.VarChar(200)
  referenceNumber        String?       @map("reference_number") @db.VarChar(100)
  status                 ExpenseStatus @default(DRAFT)
  voidReason             String?       @map("void_reason") @db.VarChar(500)
  voidedAt               DateTime?     @map("voided_at") @db.Timestamptz(3)
  voidedBy               String?       @map("voided_by") @db.Uuid
  receiptStorageKey      String?       @map("receipt_storage_key") @db.VarChar(500)
  receiptFileName        String?       @map("receipt_file_name") @db.VarChar(255)
  receiptContentType     String?       @map("receipt_content_type") @db.VarChar(100)
  receiptSizeBytes       Int?          @map("receipt_size_bytes")
  version                Int           @default(1)
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy              String        @map("created_by") @db.Uuid
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy              String        @map("updated_by") @db.Uuid

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  category             ExpenseCategory       @relation(fields: [categoryId, organizationId], references: [id, organizationId], onDelete: Restrict)
  vehicle              Vehicle?              @relation(fields: [vehicleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  driver               Driver?               @relation(fields: [driverId, organizationId], references: [id, organizationId], onDelete: Restrict)
  trip                 Trip?                 @relation(fields: [tripId, organizationId], references: [id, organizationId], onDelete: Restrict)
  maintenanceWorkOrder MaintenanceWorkOrder? @relation(fields: [maintenanceWorkOrderId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdByUser        User                  @relation("ExpenseCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser        User                  @relation("ExpenseUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  voidedByUser         User?                 @relation("ExpenseVoidedBy", fields: [voidedBy], references: [id], onDelete: Restrict)

  @@unique([organizationId, displayId])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, categoryId])
  @@index([organizationId, vehicleId, occurredAt])
  @@index([organizationId, driverId, occurredAt])
  @@index([organizationId, tripId])
  @@index([organizationId, maintenanceWorkOrderId])
  @@index([organizationId, occurredAt])
  @@map("expenses")
}

model FuelImportJob {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  fileName       String           @map("original_file_name") @db.VarChar(255)
  totalRows      Int              @map("total_rows")
  importedRows   Int              @map("imported_rows")
  failedRows     Int              @map("failed_rows")
  status         FuelImportStatus @default(PENDING)
  errorSummary   String?          @map("error_summary") @db.VarChar(1000)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy      String           @map("created_by") @db.Uuid

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdByUser User         @relation("FuelImportJobCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([id, organizationId])
  @@index([organizationId, createdAt])
  @@map("fuel_import_jobs")
}
