generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum PrincipalStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  REVOKED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
}

enum VehicleStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum VehicleType {
  CAR
  VAN
  TRUCK
  BUS
  MOTORCYCLE
  OTHER
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
  GAS
  OTHER
}

model Organization {
  id                                String                             @id @default(uuid()) @db.Uuid
  name                              String                             @db.VarChar(200)
  slug                              String                             @unique @db.VarChar(100)
  status                            PrincipalStatus                    @default(ACTIVE)
  version                           Int                                @default(1)
  createdAt                         DateTime                           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                         DateTime                           @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships                       OrganizationMembership[]
  roles                             Role[]
  auditLogs                         AuditLog[]
  outboxEvents                      OutboxEvent[]
  vehicles                          Vehicle[]
  vehicleStatusHistory              VehicleStatusHistory[]
  drivers                           Driver[]
  driverLicenses                    DriverLicense[]
  driverStatusHistory               DriverStatusHistory[]
  vehicleDriverAssignments          VehicleDriverAssignment[]
  trips                             Trip[]
  tripStatusHistory                 TripStatusHistory[]
  inspectionTemplates               InspectionTemplate[]
  inspectionTemplateItems           InspectionTemplateItem[]
  inspections                       Inspection[]
  inspectionResponses               InspectionResponse[]
  maintenanceRequests               MaintenanceRequest[]
  maintenancePlans                  MaintenancePlan[]
  vehicleMaintenanceSchedules       VehicleMaintenanceSchedule[]
  maintenanceVendors                MaintenanceVendor[]
  maintenanceWorkOrders             MaintenanceWorkOrder[]
  maintenanceWorkOrderTasks         MaintenanceWorkOrderTask[]
  maintenanceWorkOrderParts         MaintenanceWorkOrderPart[]
  maintenanceWorkOrderLabor         MaintenanceWorkOrderLabor[]
  complianceDocumentTypes           ComplianceDocumentType[]
  complianceDocuments               ComplianceDocument[]
  fuelTransactions                  FuelTransaction[]
  fuelTransactionAnomalies          FuelTransactionAnomaly[]
  expenseCategories                 ExpenseCategory[]
  expenses                          Expense[]
  fuelImportJobs                    FuelImportJob[]
  incidents                         Incident[]
  incidentStatusHistory             IncidentStatusHistory[]
  incidentNotes                     IncidentNote[]
  incidentAttachments               IncidentAttachment[]
  notifications                     Notification[]
  notificationRecipients            NotificationRecipient[]
  notificationDeliveryAttempts      NotificationDeliveryAttempt[]
  integrationConnections            IntegrationConnection[]
  integrationSecrets                IntegrationSecret[]
  webhookSubscriptions              WebhookSubscription[]
  webhookDeliveries                 WebhookDelivery[]
  webhookDeliveryAttempts           WebhookDeliveryAttempt[]
  inboundIntegrationReceipts        InboundIntegrationReceipt[]
  integrationDeviceMappings         IntegrationDeviceMapping[]
  fuelCardImportBatches             FuelCardImportBatch[]
  externalTransactionIdentities     ExternalTransactionIdentity[]
  accountingExportLogs              AccountingExportLog[]
  notificationPreferences           NotificationPreference[]
  notificationTemplates             NotificationTemplate[]
  automationDeduplications          AutomationDeduplication[]
  telemetryDevices                  TelemetryDevice[]
  telemetryDeviceVehicleAssignments TelemetryDeviceVehicleAssignment[]
  telemetryPositions                TelemetryPosition[]
  telemetryCurrentPositions         TelemetryCurrentPosition[]
  telemetryDeviceCredentials        TelemetryDeviceCredential[]

  @@map("organizations")
}

model User {
  id                            String                             @id @default(uuid()) @db.Uuid
  email                         String                             @unique @db.VarChar(320)
  displayName                   String                             @map("display_name") @db.VarChar(200)
  status                        PrincipalStatus                    @default(ACTIVE)
  version                       Int                                @default(1)
  createdAt                     DateTime                           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                     DateTime                           @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships                   OrganizationMembership[]
  auditLogs                     AuditLog[]
  vehicleStatusHistory          VehicleStatusHistory[]
  driverStatusHistory           DriverStatusHistory[]
  tripsCreated                  Trip[]                             @relation("TripCreatedBy")
  tripsUpdated                  Trip[]                             @relation("TripUpdatedBy")
  tripStatusHistory             TripStatusHistory[]
  inspectionTemplatesCreated    InspectionTemplate[]               @relation("InspectionTemplateCreatedBy")
  inspectionTemplatesUpdated    InspectionTemplate[]               @relation("InspectionTemplateUpdatedBy")
  inspectionsCreated            Inspection[]                       @relation("InspectionCreatedBy")
  inspectionsUpdated            Inspection[]                       @relation("InspectionUpdatedBy")
  inspectionsPerformed          Inspection[]                       @relation("InspectionPerformedBy")
  maintenanceRequestsCreated    MaintenanceRequest[]               @relation("MaintenanceRequestCreatedBy")
  maintenanceRequestsUpdated    MaintenanceRequest[]               @relation("MaintenanceRequestUpdatedBy")
  maintenancePlansCreated       MaintenancePlan[]                  @relation("MaintenancePlanCreatedBy")
  maintenancePlansUpdated       MaintenancePlan[]                  @relation("MaintenancePlanUpdatedBy")
  maintenanceVendorsCreated     MaintenanceVendor[]                @relation("MaintenanceVendorCreatedBy")
  maintenanceVendorsUpdated     MaintenanceVendor[]                @relation("MaintenanceVendorUpdatedBy")
  maintenanceWorkOrdersCreated  MaintenanceWorkOrder[]             @relation("MaintenanceWorkOrderCreatedBy")
  maintenanceWorkOrdersUpdated  MaintenanceWorkOrder[]             @relation("MaintenanceWorkOrderUpdatedBy")
  complianceDocTypesCreated     ComplianceDocumentType[]           @relation("ComplianceDocTypeCreatedBy")
  complianceDocTypesUpdated     ComplianceDocumentType[]           @relation("ComplianceDocTypeUpdatedBy")
  complianceDocsCreated         ComplianceDocument[]               @relation("ComplianceDocCreatedBy")
  complianceDocsUpdated         ComplianceDocument[]               @relation("ComplianceDocUpdatedBy")
  complianceDocsRevoked         ComplianceDocument[]               @relation("ComplianceDocRevokedBy")
  fuelTransactionsCreated       FuelTransaction[]                  @relation("FuelTransactionCreatedBy")
  fuelTransactionsUpdated       FuelTransaction[]                  @relation("FuelTransactionUpdatedBy")
  fuelTransactionsVoided        FuelTransaction[]                  @relation("FuelTransactionVoidedBy")
  expenseCategoriesCreated      ExpenseCategory[]                  @relation("ExpenseCategoryCreatedBy")
  expenseCategoriesUpdated      ExpenseCategory[]                  @relation("ExpenseCategoryUpdatedBy")
  expensesCreated               Expense[]                          @relation("ExpenseCreatedBy")
  expensesUpdated               Expense[]                          @relation("ExpenseUpdatedBy")
  expensesVoided                Expense[]                          @relation("ExpenseVoidedBy")
  fuelImportJobsCreated         FuelImportJob[]                    @relation("FuelImportJobCreatedBy")
  incidentsCreated              Incident[]                         @relation("IncidentCreatedBy")
  incidentsUpdated              Incident[]                         @relation("IncidentUpdatedBy")
  incidentStatusHistory         IncidentStatusHistory[]            @relation("IncidentStatusActor")
  incidentNotesCreated          IncidentNote[]                     @relation("IncidentNoteCreatedBy")
  incidentAttachmentsCreated    IncidentAttachment[]               @relation("IncidentAttachmentCreatedBy")
  notificationRecipients        NotificationRecipient[]
  notificationPreferences       NotificationPreference[]
  deviceAssignments             TelemetryDeviceVehicleAssignment[] @relation("DeviceAssignedBy")
  revokedDeviceCredentials      TelemetryDeviceCredential[]        @relation("DeviceCredentialRevokedBy")
  integrationConnectionsCreated IntegrationConnection[]            @relation("IntegrationConnectionCreatedBy")
  integrationConnectionsUpdated IntegrationConnection[]            @relation("IntegrationConnectionUpdatedBy")
  integrationSecretsRevoked     IntegrationSecret[]                @relation("IntegrationSecretRevokedBy")
  fuelCardBatchesConfirmed      FuelCardImportBatch[]              @relation("FuelCardBatchConfirmedBy")
  accountingExportsCreated      AccountingExportLog[]              @relation("AccountingExportActor")

  @@map("users")
}

model OrganizationMembership {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  status          MembershipStatus @default(INVITED)
  version         Int              @default(1)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user            User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  roleAssignments MembershipRole[]

  @@unique([organizationId, userId])
  @@unique([id, organizationId])
  @@index([userId, status])
  @@index([organizationId, status])
  @@map("organization_memberships")
}

model Role {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  name           String           @db.VarChar(100)
  description    String?          @db.VarChar(500)
  version        Int              @default(1)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  permissions    RolePermission[]
  assignments    MembershipRole[]

  @@unique([organizationId, name])
  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(100)
  description String           @db.VarChar(500)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model MembershipRole {
  membershipId   String                 @map("membership_id") @db.Uuid
  roleId         String                 @map("role_id") @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  membership     OrganizationMembership @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Cascade)
  role           Role                   @relation(fields: [roleId, organizationId], references: [id, organizationId], onDelete: Cascade)
  assignedAt     DateTime               @default(now()) @map("assigned_at") @db.Timestamptz(3)

  @@id([membershipId, roleId])
  @@index([roleId])
  @@index([organizationId])
  @@map("membership_roles")
}

model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  actorId        String       @map("actor_id") @db.Uuid
  action         String       @db.VarChar(100)
  entityType     String       @map("entity_type") @db.VarChar(100)
  entityId       String       @map("entity_id") @db.Uuid
  beforeData     Json?        @map("before_data")
  afterData      Json?        @map("after_data")
  requestId      String       @map("request_id") @db.VarChar(100)
  ipAddress      String?      @map("ip_address") @db.VarChar(45)
  userAgent      String?      @map("user_agent") @db.VarChar(500)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor          User         @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@map("audit_logs")
}

model OutboxEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  eventType      String       @map("event_type") @db.VarChar(150)
  aggregateType  String       @map("aggregate_type") @db.VarChar(100)
  aggregateId    String       @map("aggregate_id") @db.Uuid
  payload        Json
  occurredAt     DateTime     @map("occurred_at") @db.Timestamptz(3)
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  availableAt    DateTime     @default(now()) @map("available_at") @db.Timestamptz(3)
  lockedAt       DateTime?    @map("locked_at") @db.Timestamptz(3)
  lockedBy       String?      @map("locked_by") @db.VarChar(100)
  publishedAt    DateTime?    @map("published_at") @db.Timestamptz(3)
  lastError      String?      @map("last_error") @db.VarChar(1000)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([status, availableAt, occurredAt])
  @@index([organizationId, occurredAt])
  @@map("outbox_events")
}

model Vehicle {
  id                       String                             @id @default(uuid()) @db.Uuid
  organizationId           String                             @map("organization_id") @db.Uuid
  displayId                String                             @map("display_id") @db.VarChar(40)
  registration             String                             @db.VarChar(30)
  vin                      String                             @unique @db.VarChar(17)
  type                     VehicleType
  fuelType                 FuelType                           @map("fuel_type")
  model                    String                             @db.VarChar(100)
  year                     Int
  odometerKm               Int                                @map("odometer_km")
  status                   VehicleStatus                      @default(DRAFT)
  notes                    String?                            @db.VarChar(500)
  version                  Int                                @default(1)
  createdAt                DateTime                           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                           @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization             Organization                       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  statusHistory            VehicleStatusHistory[]
  assignments              VehicleDriverAssignment[]
  trips                    Trip[]
  inspections              Inspection[]
  maintenanceRequests      MaintenanceRequest[]
  maintenanceSchedules     VehicleMaintenanceSchedule[]
  maintenanceWorkOrders    MaintenanceWorkOrder[]
  complianceDocuments      ComplianceDocument[]
  fuelTransactions         FuelTransaction[]
  expenses                 Expense[]
  incidents                Incident[]
  telemetryAssignments     TelemetryDeviceVehicleAssignment[]
  telemetryPositions       TelemetryPosition[]
  telemetryCurrentPosition TelemetryCurrentPosition?

  @@unique([organizationId, displayId])
  @@unique([organizationId, registration])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, model, year])
  @@map("vehicles")
}

model VehicleStatusHistory {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  vehicleId      String         @map("vehicle_id") @db.Uuid
  previousStatus VehicleStatus? @map("previous_status")
  newStatus      VehicleStatus  @map("new_status")
  reason         String         @db.VarChar(500)
  changedBy      String         @map("changed_by") @db.Uuid
  requestId      String         @map("request_id") @db.VarChar(100)
  ipAddress      String?        @map("ip_address") @db.VarChar(45)
  userAgent      String?        @map("user_agent") @db.VarChar(500)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  vehicle        Vehicle        @relation(fields: [vehicleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  actor          User           @relation(fields: [changedBy], references: [id], onDelete: Restrict)

  @@index([organizationId, vehicleId, createdAt])
  @@map("vehicle_status_history")
}

enum DriverStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  INACTIVE
}

model Driver {
  id                  String                    @id @default(uuid()) @db.Uuid
  organizationId      String                    @map("organization_id") @db.Uuid
  displayId           String                    @map("display_id") @db.VarChar(40)
  employeeNumber      String?                   @map("employee_number") @db.VarChar(50)
  firstName           String                    @map("first_name") @db.VarChar(100)
  lastName            String                    @map("last_name") @db.VarChar(100)
  email               String?                   @db.VarChar(320)
  phone               String?                   @db.VarChar(50)
  status              DriverStatus              @default(DRAFT)
  notes               String?                   @db.VarChar(500)
  version             Int                       @default(1)
  createdAt           DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization        Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  licenses            DriverLicense[]
  statusHistory       DriverStatusHistory[]
  assignments         VehicleDriverAssignment[]
  trips               Trip[]
  inspections         Inspection[]
  complianceDocuments ComplianceDocument[]
  fuelTransactions    FuelTransaction[]
  expenses            Expense[]
  incidents           Incident[]

  @@unique([organizationId, displayId])
  @@unique([organizationId, employeeNumber])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, lastName, firstName])
  @@map("drivers")
}

model DriverLicense {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  driverId       String       @map("driver_id") @db.Uuid
  licenseNumber  String       @map("license_number") @db.VarChar(50)
  issuingCountry String       @map("issuing_country") @db.VarChar(3)
  issuingRegion  String?      @map("issuing_region") @db.VarChar(50)
  licenseClasses String[]     @map("license_classes")
  issueDate      DateTime     @map("issue_date") @db.Timestamptz(3)
  expiryDate     DateTime     @map("expiry_date") @db.Timestamptz(3)
  notes          String?      @db.VarChar(500)
  version        Int          @default(1)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  driver         Driver       @relation(fields: [driverId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([organizationId, licenseNumber, issuingCountry])
  @@unique([id, organizationId])
  @@index([organizationId, driverId])
  @@index([organizationId, expiryDate])
  @@map("driver_licenses")
}

model DriverStatusHistory {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  driverId       String        @map("driver_id") @db.Uuid
  fromStatus     DriverStatus? @map("from_status")
  toStatus       DriverStatus  @map("to_status")
  reason         String        @db.VarChar(500)
  changedBy      String        @map("changed_by") @db.Uuid
  requestId      String        @map("request_id") @db.VarChar(100)
  ipAddress      String?       @map("ip_address") @db.VarChar(45)
  userAgent      String?       @map("user_agent") @db.VarChar(500)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  driver         Driver        @relation(fields: [driverId, organizationId], references: [id, organizationId], onDelete: Cascade)
  actor          User          @relation(fields: [changedBy], references: [id], onDelete: Restrict)

  @@index([organizationId, driverId, createdAt])
  @@map("driver_status_history")
}

enum AssignmentStatus {
  ACTIVE
  ENDED
}

model VehicleDriverAssignment {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  vehicleId      String           @map("vehicle_id") @db.Uuid
  driverId       String           @map("driver_id") @db.Uuid
  status         AssignmentStatus @default(ACTIVE)
  startedAt      DateTime         @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt        DateTime?        @map("ended_at") @db.Timestamptz(3)
  endReason      String?          @map("end_reason") @db.VarChar(500)
  notes          String?          @db.VarChar(500)
  version        Int              @default(1)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  vehicle      Vehicle      @relation(fields: [vehicleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  driver       Driver       @relation(fields: [driverId, organizationId], references: [id, organizationId], onDelete: Restrict)
  trips        Trip[]
  inspections  Inspection[]
  incidents    Incident[]

  @@unique([id, organizationId, vehicleId, driverId])
  @@unique([id, organizationId])
  @@index([organizationId, vehicleId])
  @@index([organizationId, driverId])
  @@index([organizationId, status])
  @@map("vehicle_driver_assignments")
}

enum TripStatus {
  DRAFT
  READY
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ABORTED
}

model Trip {
  id              String     @id @default(uuid()) @db.Uuid
  organizationId  String     @map("organization_id") @db.Uuid
  displayId       String     @map("display_id") @db.VarChar(40)
  assignmentId    String     @map("assignment_id") @db.Uuid
  vehicleId       String     @map("vehicle_id") @db.Uuid
  driverId        String     @map("driver_id") @db.Uuid
  status          TripStatus @default(DRAFT)
  origin          String     @db.VarChar(200)
  destination     String     @db.VarChar(200)
  purpose         String?    @db.VarChar(500)
  plannedStartAt  DateTime?  @map("planned_start_at") @db.Timestamptz(3)
  plannedEndAt    DateTime?  @map("planned_end_at") @db.Timestamptz(3)
  actualStartAt   DateTime?  @map("actual_start_at") @db.Timestamptz(3)
  actualEndAt     DateTime?  @map("actual_end_at") @db.Timestamptz(3)
  startOdometerKm Int?       @map("start_odometer_km")
  endOdometerKm   Int?       @map("end_odometer_km")
  distanceKm      Int?       @map("distance_km")
  cancelReason    String?    @map("cancel_reason") @db.VarChar(500)
  abortReason     String?    @map("abort_reason") @db.VarChar(500)
  notes           String?    @db.VarChar(500)
  version         Int        @default(1)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy       String     @map("created_by") @db.Uuid
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy       String     @map("updated_by") @db.Uuid

  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignment         VehicleDriverAssignment @relation(fields: [assignmentId, organizationId, vehicleId, driverId], references: [id, organizationId, vehicleId, driverId], onDelete: Restrict)
  vehicle            Vehicle                 @relation(fields: [vehicleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  driver             Driver                  @relation(fields: [driverId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdByUser      User                    @relation("TripCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser      User                    @relation("TripUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  statusHistory      TripStatusHistory[]
  inspections        Inspection[]
  fuelTransactions   FuelTransaction[]
  expenses           Expense[]
  incidents          Incident[]
  telemetryPositions TelemetryPosition[]

  @@unique([organizationId, displayId])
  @@unique([id, organizationId])
  @@unique([id, organizationId, vehicleId, driverId, assignmentId])
  @@index([organizationId, status])
  @@index([organizationId, vehicleId])
  @@index([organizationId, driverId])
  @@index([organizationId, assignmentId])
  @@index([organizationId, createdAt])
  @@index([organizationId, actualStartAt])
  @@index([organizationId, vehicleId, actualStartAt])
  @@index([organizationId, driverId, actualStartAt])
  @@map("trips")
}

model TripStatusHistory {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  tripId         String      @map("trip_id") @db.Uuid
  fromStatus     TripStatus? @map("from_status")
  toStatus       TripStatus  @map("to_status")
  reason         String?     @db.VarChar(500)
  changedBy      String      @map("changed_by") @db.Uuid
  requestId      String      @map("request_id") @db.VarChar(100)
  ipAddress      String?     @map("ip_address") @db.VarChar(45)
  userAgent      String?     @map("user_agent") @db.VarChar(500)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  trip         Trip         @relation(fields: [tripId, organizationId], references: [id, organizationId], onDelete: Cascade)
  actor        User         @relation(fields: [changedBy], references: [id], onDelete: Restrict)

  @@index([organizationId, tripId, createdAt])
  @@map("trip_status_history")
}

enum InspectionType {
  PRE_TRIP
  POST_TRIP
  PERIODIC
  SAFETY
  CUSTOM
}

enum InspectionTemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum InspectionItemSeverity {
  NORMAL
  CRITICAL
}

enum InspectionStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InspectionResult {
  PASS
  FAIL
}

enum InspectionResponseResult {
  PASS
  FAIL
  NOT_APPLICABLE
}

model InspectionTemplate {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  name           String                   @db.VarChar(200)
  description    String?                  @db.VarChar(500)
  type           InspectionType
  status         InspectionTemplateStatus @default(DRAFT)
  version        Int                      @default(1)
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy      String                   @map("created_by") @db.Uuid
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy      String                   @map("updated_by") @db.Uuid

  organization  Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdByUser User                     @relation("InspectionTemplateCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser User                     @relation("InspectionTemplateUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  items         InspectionTemplateItem[]
  inspections   Inspection[]

  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, type, status])
  @@map("inspection_templates")
}

model InspectionTemplateItem {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  templateId     String                 @map("template_id") @db.Uuid
  category       String                 @db.VarChar(100)
  prompt         String                 @db.VarChar(500)
  description    String?                @db.VarChar(500)
  required       Boolean                @default(true)
  severity       InspectionItemSeverity @default(NORMAL)
  sortOrder      Int                    @default(0) @map("sort_order")
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  template     InspectionTemplate   @relation(fields: [templateId, organizationId], references: [id, organizationId], onDelete: Cascade)
  responses    InspectionResponse[]

  @@unique([id, organizationId])
  @@index([organizationId, templateId, sortOrder])
  @@map("inspection_template_items")
}

model Inspection {
  id                 String            @id @default(uuid()) @db.Uuid
  organizationId     String            @map("organization_id") @db.Uuid
  displayId          String            @map("display_id") @db.VarChar(40)
  templateId         String            @map("template_id") @db.Uuid
  type               InspectionType
  vehicleId          String            @map("vehicle_id") @db.Uuid
  driverId           String?           @map("driver_id") @db.Uuid
  assignmentId       String?           @map("assignment_id") @db.Uuid
  tripId             String?           @map("trip_id") @db.Uuid
  status             InspectionStatus  @default(DRAFT)
  result             InspectionResult?
  hasCriticalFailure Boolean           @default(false) @map("has_critical_failure")
  startedAt          DateTime?         @map("started_at") @db.Timestamptz(3)
  completedAt        DateTime?         @map("completed_at") @db.Timestamptz(3)
  cancelledAt        DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  cancelReason       String?           @map("cancel_reason") @db.VarChar(500)
  performedBy        String?           @map("performed_by") @db.Uuid
  notes              String?           @db.VarChar(500)
  version            Int               @default(1)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy          String            @map("created_by") @db.Uuid
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy          String            @map("updated_by") @db.Uuid

  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  template            InspectionTemplate       @relation(fields: [templateId, organizationId], references: [id, organizationId], onDelete: Restrict)
  vehicle             Vehicle                  @relation(fields: [vehicleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  driver              Driver?                  @relation(fields: [driverId], references: [id], onDelete: Restrict)
  assignment          VehicleDriverAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  trip                Trip?                    @relation(fields: [tripId], references: [id], onDelete: Restrict)
  createdByUser       User                     @relation("InspectionCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser       User                     @relation("InspectionUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  performedByUser     User?                    @relation("InspectionPerformedBy", fields: [performedBy], references: [id], onDelete: Restrict)
  responses           InspectionResponse[]
  maintenanceRequests MaintenanceRequest[]

  @@unique([organizationId, displayId])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, type])
  @@index([organizationId, result])
  @@index([organizationId, vehicleId, createdAt])
  @@index([organizationId, tripId, createdAt])
  @@index([organizationId, driverId, createdAt])
  @@index([organizationId, tripId, type, status, completedAt])
  @@index([organizationId, createdAt])
  @@map("inspections")
}

model InspectionResponse {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  inspectionId   String                   @map("inspection_id") @db.Uuid
  templateItemId String                   @map("template_item_id") @db.Uuid
  response       InspectionResponseResult
  comment        String?                  @db.VarChar(500)
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  inspection   Inspection             @relation(fields: [inspectionId, organizationId], references: [id, organizationId], onDelete: Cascade)
  templateItem InspectionTemplateItem @relation(fields: [templateItemId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, inspectionId, templateItemId])
  @@index([organizationId, inspectionId])
  @@map("inspection_responses")
}

enum MaintenanceRequestSource {
  MANUAL
  INSPECTION
  PREVENTIVE
  INCIDENT
}

enum MaintenancePriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum MaintenanceRequestStatus {
  OPEN
  CONVERTED
  CANCELLED
}

enum MaintenanceWorkOrderStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MaintenancePlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MaintenanceVendorStatus {
  ACTIVE
  INACTIVE
}

enum WorkOrderTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

model MaintenanceRequest {
  id                   String                   @id @default(uuid()) @db.Uuid
  organizationId       String                   @map("organization_id") @db.Uuid
  displayId            String                   @map("display_id") @db.VarChar(40)
  vehicleId            String                   @map("vehicle_id") @db.Uuid
  sourceType           MaintenanceRequestSource @map("source_type")
  sourceInspectionId   String?                  @map("source_inspection_id") @db.Uuid
  sourceIncidentId     String?                  @map("source_incident_id") @db.Uuid
  title                String                   @db.VarChar(200)
  description          String?                  @db.VarChar(1000)
  priority             MaintenancePriority      @default(NORMAL)
  blocksOperation      Boolean                  @default(false) @map("blocks_operation")
  status               MaintenanceRequestStatus @default(OPEN)
  convertedWorkOrderId String?                  @map("converted_work_order_id") @db.Uuid
  version              Int                      @default(1)
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy            String                   @map("created_by") @db.Uuid
  updatedAt            DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy            String                   @map("updated_by") @db.Uuid

  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  vehicle            Vehicle                @relation(fields: [vehicleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  sourceInspection   Inspection?            @relation(fields: [sourceInspectionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  sourceIncident     Incident?              @relation("IncidentMaintenanceRequests", fields: [sourceIncidentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  convertedWorkOrder MaintenanceWorkOrder?  @relation("RequestConvertedWorkOrder", fields: [convertedWorkOrderId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdByUser      User                   @relation("MaintenanceRequestCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser      User                   @relation("MaintenanceRequestUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  workOrders         MaintenanceWorkOrder[] @relation("RequestWorkOrders")

  @@unique([organizationId, displayId])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, vehicleId, status])
  @@index([organizationId, status, priority])
  @@index([organizationId, sourceInspectionId])
  @@index([organizationId, sourceIncidentId])
  @@map("maintenance_requests")
}

model MaintenancePlan {
  id                     String                @id @default(uuid()) @db.Uuid
  organizationId         String                @map("organization_id") @db.Uuid
  displayId              String                @map("display_id") @db.VarChar(40)
  name                   String                @db.VarChar(200)
  description            String?               @db.VarChar(500)
  status                 MaintenancePlanStatus @default(DRAFT)
  intervalDays           Int?                  @map("interval_days")
  intervalOdometerKm     Int?                  @map("interval_odometer_km")
  defaultPriority        MaintenancePriority   @default(NORMAL) @map("default_priority")
  blocksOperationWhenDue Boolean               @default(false) @map("blocks_operation_when_due")
  version                Int                   @default(1)
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy              String                @map("created_by") @db.Uuid
  updatedAt              DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy              String                @map("updated_by") @db.Uuid

  organization  Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdByUser User                         @relation("MaintenancePlanCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser User                         @relation("MaintenancePlanUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  schedules     VehicleMaintenanceSchedule[]

  @@unique([organizationId, displayId])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@map("maintenance_plans")
}

model VehicleMaintenanceSchedule {
  id                      String    @id @default(uuid()) @db.Uuid
  organizationId          String    @map("organization_id") @db.Uuid
  vehicleId               String    @map("vehicle_id") @db.Uuid
  maintenancePlanId       String    @map("maintenance_plan_id") @db.Uuid
  lastCompletedAt         DateTime? @map("last_completed_at") @db.Timestamptz(3)
  lastCompletedOdometerKm Int?      @map("last_completed_odometer_km")
  nextDueAt               DateTime? @map("next_due_at") @db.Timestamptz(3)
  nextDueOdometerKm       Int?      @map("next_due_odometer_km")
  version                 Int       @default(1)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy               String    @map("created_by") @db.Uuid
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy               String    @map("updated_by") @db.Uuid

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  vehicle      Vehicle                @relation(fields: [vehicleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  plan         MaintenancePlan        @relation(fields: [maintenancePlanId, organizationId], references: [id, organizationId], onDelete: Restrict)
  workOrders   MaintenanceWorkOrder[]

  @@unique([organizationId, vehicleId, maintenancePlanId])
  @@unique([id, organizationId])
  @@index([organizationId, vehicleId])
  @@index([organizationId, nextDueAt])
  @@index([organizationId, nextDueOdometerKm])
  @@map("vehicle_maintenance_schedules")
}

model MaintenanceVendor {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @map("organization_id") @db.Uuid
  displayId      String                  @map("display_id") @db.VarChar(40)
  name           String                  @db.VarChar(200)
  contactName    String?                 @map("contact_name") @db.VarChar(200)
  phone          String?                 @db.VarChar(50)
  email          String?                 @db.VarChar(200)
  notes          String?                 @db.VarChar(500)
  status         MaintenanceVendorStatus @default(ACTIVE)
  version        Int                     @default(1)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy      String                  @map("created_by") @db.Uuid
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy      String                  @map("updated_by") @db.Uuid

  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdByUser User                   @relation("MaintenanceVendorCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser User                   @relation("MaintenanceVendorUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  workOrders    MaintenanceWorkOrder[]

  @@unique([organizationId, displayId])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@map("maintenance_vendors")
}

model MaintenanceWorkOrder {
  id                    String                     @id @default(uuid()) @db.Uuid
  organizationId        String                     @map("organization_id") @db.Uuid
  displayId             String                     @map("display_id") @db.VarChar(40)
  vehicleId             String                     @map("vehicle_id") @db.Uuid
  maintenanceRequestId  String?                    @map("maintenance_request_id") @db.Uuid
  maintenanceScheduleId String?                    @map("maintenance_schedule_id") @db.Uuid
  vendorId              String?                    @map("vendor_id") @db.Uuid
  title                 String                     @db.VarChar(200)
  description           String?                    @db.VarChar(1000)
  priority              MaintenancePriority        @default(NORMAL)
  blocksOperation       Boolean                    @default(false) @map("blocks_operation")
  status                MaintenanceWorkOrderStatus @default(DRAFT)
  openedAt              DateTime?                  @map("opened_at") @db.Timestamptz(3)
  startedAt             DateTime?                  @map("started_at") @db.Timestamptz(3)
  completedAt           DateTime?                  @map("completed_at") @db.Timestamptz(3)
  cancelledAt           DateTime?                  @map("cancelled_at") @db.Timestamptz(3)
  cancelReason          String?                    @map("cancel_reason") @db.VarChar(500)
  completionNotes       String?                    @map("completion_notes") @db.VarChar(1000)
  odometerAtOpen        Int?                       @map("odometer_at_open")
  odometerAtCompletion  Int?                       @map("odometer_at_completion")
  version               Int                        @default(1)
  createdAt             DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy             String                     @map("created_by") @db.Uuid
  updatedAt             DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy             String                     @map("updated_by") @db.Uuid

  organization          Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  vehicle               Vehicle                     @relation(fields: [vehicleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  request               MaintenanceRequest?         @relation("RequestWorkOrders", fields: [maintenanceRequestId, organizationId], references: [id, organizationId], onDelete: Restrict)
  schedule              VehicleMaintenanceSchedule? @relation(fields: [maintenanceScheduleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  vendor                MaintenanceVendor?          @relation(fields: [vendorId, organizationId], references: [id, organizationId], onDelete: Restrict)
  convertedFromRequests MaintenanceRequest[]        @relation("RequestConvertedWorkOrder")
  createdByUser         User                        @relation("MaintenanceWorkOrderCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser         User                        @relation("MaintenanceWorkOrderUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  tasks                 MaintenanceWorkOrderTask[]
  parts                 MaintenanceWorkOrderPart[]
  labor                 MaintenanceWorkOrderLabor[]
  expenses              Expense[]

  @@unique([organizationId, displayId])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, vehicleId, status])
  @@index([organizationId, maintenanceRequestId])
  @@index([organizationId, maintenanceScheduleId])
  @@map("maintenance_work_orders")
}

model MaintenanceWorkOrderTask {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  workOrderId    String              @map("work_order_id") @db.Uuid
  description    String              @db.VarChar(500)
  status         WorkOrderTaskStatus @default(PENDING)
  sortOrder      Int                 @default(0) @map("sort_order")
  notes          String?             @db.VarChar(500)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workOrder    MaintenanceWorkOrder @relation(fields: [workOrderId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([id, organizationId])
  @@index([organizationId, workOrderId, sortOrder])
  @@map("maintenance_work_order_tasks")
}

model MaintenanceWorkOrderPart {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  workOrderId    String   @map("work_order_id") @db.Uuid
  description    String   @db.VarChar(200)
  partNumber     String?  @map("part_number") @db.VarChar(100)
  quantity       Decimal  @db.Decimal(10, 2)
  unitCost       Decimal  @map("unit_cost") @db.Decimal(10, 2)
  totalCost      Decimal  @map("total_cost") @db.Decimal(10, 2)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workOrder    MaintenanceWorkOrder @relation(fields: [workOrderId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([id, organizationId])
  @@index([organizationId, workOrderId])
  @@map("maintenance_work_order_parts")
}

model MaintenanceWorkOrderLabor {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  workOrderId    String   @map("work_order_id") @db.Uuid
  description    String   @db.VarChar(200)
  hours          Decimal  @db.Decimal(10, 2)
  hourlyRate     Decimal  @map("hourly_rate") @db.Decimal(10, 2)
  totalCost      Decimal  @map("total_cost") @db.Decimal(10, 2)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workOrder    MaintenanceWorkOrder @relation(fields: [workOrderId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([id, organizationId])
  @@index([organizationId, workOrderId])
  @@map("maintenance_work_order_labor")
}

enum ComplianceSubjectType {
  VEHICLE
  DRIVER
}

enum ComplianceDocumentTypeStatus {
  ACTIVE
  ARCHIVED
}

enum ComplianceDocumentStatus {
  ACTIVE
  SUPERSEDED
  REVOKED
}

model ComplianceDocumentType {
  id                      String                       @id @default(uuid()) @db.Uuid
  organizationId          String                       @map("organization_id") @db.Uuid
  code                    String                       @db.VarChar(100)
  name                    String                       @db.VarChar(200)
  description             String?                      @db.VarChar(500)
  subjectType             ComplianceSubjectType        @map("subject_type")
  status                  ComplianceDocumentTypeStatus @default(ACTIVE)
  required                Boolean                      @default(false)
  blocksOperation         Boolean                      @default(false) @map("blocks_operation")
  requiresExpiry          Boolean                      @default(false) @map("requires_expiry")
  warningDaysBeforeExpiry Int                          @default(30) @map("warning_days_before_expiry")
  version                 Int                          @default(1)
  createdAt               DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy               String                       @map("created_by") @db.Uuid
  updatedAt               DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy               String                       @map("updated_by") @db.Uuid

  organization  Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdByUser User                 @relation("ComplianceDocTypeCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser User                 @relation("ComplianceDocTypeUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  documents     ComplianceDocument[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@unique([id, organizationId, subjectType])
  @@index([organizationId, status])
  @@index([organizationId, subjectType, status])
  @@map("compliance_document_types")
}

model ComplianceDocument {
  id               String                   @id @default(uuid()) @db.Uuid
  organizationId   String                   @map("organization_id") @db.Uuid
  displayId        String                   @map("display_id") @db.VarChar(40)
  documentTypeId   String                   @map("document_type_id") @db.Uuid
  subjectType      ComplianceSubjectType    @map("subject_type")
  vehicleId        String?                  @map("vehicle_id") @db.Uuid
  driverId         String?                  @map("driver_id") @db.Uuid
  documentNumber   String?                  @map("document_number") @db.VarChar(100)
  issuerName       String?                  @map("issuer_name") @db.VarChar(200)
  issuedOn         DateTime?                @map("issued_on") @db.Date
  expiresOn        DateTime?                @map("expires_on") @db.Date
  status           ComplianceDocumentStatus @default(ACTIVE)
  notes            String?                  @db.VarChar(1000)
  objectKey        String                   @map("object_key") @db.VarChar(500)
  originalFileName String                   @map("original_file_name") @db.VarChar(255)
  mimeType         String                   @map("mime_type") @db.VarChar(100)
  sizeBytes        Int                      @map("size_bytes")
  storageETag      String?                  @map("storage_etag") @db.VarChar(100)
  supersededAt     DateTime?                @map("superseded_at") @db.Timestamptz(3)
  supersededById   String?                  @map("superseded_by_id") @db.Uuid
  revokedAt        DateTime?                @map("revoked_at") @db.Timestamptz(3)
  revokedBy        String?                  @map("revoked_by") @db.Uuid
  revocationReason String?                  @map("revocation_reason") @db.VarChar(500)
  version          Int                      @default(1)
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy        String                   @map("created_by") @db.Uuid
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy        String                   @map("updated_by") @db.Uuid

  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  documentType  ComplianceDocumentType @relation(fields: [documentTypeId, organizationId, subjectType], references: [id, organizationId, subjectType], onDelete: Restrict)
  vehicle       Vehicle?               @relation(fields: [vehicleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  driver        Driver?                @relation(fields: [driverId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdByUser User                   @relation("ComplianceDocCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser User                   @relation("ComplianceDocUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  revokedByUser User?                  @relation("ComplianceDocRevokedBy", fields: [revokedBy], references: [id], onDelete: Restrict)
  supersededBy  ComplianceDocument?    @relation("DocumentSupersession", fields: [supersededById, organizationId], references: [id, organizationId], onDelete: Restrict)
  supersedes    ComplianceDocument[]   @relation("DocumentSupersession")

  @@unique([organizationId, displayId])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, subjectType, status])
  @@index([organizationId, vehicleId, status])
  @@index([organizationId, driverId, status])
  @@index([organizationId, expiresOn])
  @@index([organizationId, createdAt])
  @@map("compliance_documents")
}

enum FuelQuantityUnit {
  LITER
  KWH
  KG
  GALLON
}

enum FuelTransactionSource {
  MANUAL
  CSV_IMPORT
  FUEL_CARD_IMPORT
}

enum FuelTransactionStatus {
  POSTED
  VOIDED
}

enum FuelAnomalyCode {
  ODOMETER_REGRESSION
  DUPLICATE_REFERENCE
  DUPLICATE_TRANSACTION
