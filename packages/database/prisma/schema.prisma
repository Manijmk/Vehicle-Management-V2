  status            IncidentStatus            @default(REPORTED)
  vehicleId         String?                   @map("vehicle_id") @db.Uuid
  driverId          String?                   @map("driver_id") @db.Uuid
  tripId            String?                   @map("trip_id") @db.Uuid
  assignmentId      String?                   @map("assignment_id") @db.Uuid
  occurredAt        DateTime                  @map("occurred_at") @db.Timestamptz(3)
  reportedAt        DateTime                  @default(now()) @map("reported_at") @db.Timestamptz(3)
  title             String                    @db.VarChar(200)
  description       String                    @db.VarChar(2000)
  locationText      String?                   @map("location_text") @db.VarChar(300)
  operationalImpact IncidentOperationalImpact @default(NONE) @map("operational_impact")
  resolutionSummary String?                   @map("resolution_summary") @db.VarChar(2000)
  resolvedAt        DateTime?                 @map("resolved_at") @db.Timestamptz(3)
  closedAt          DateTime?                 @map("closed_at") @db.Timestamptz(3)
  cancelReason      String?                   @map("cancel_reason") @db.VarChar(1000)
  version           Int                       @default(1)
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy         String                    @map("created_by") @db.Uuid
  updatedAt         DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy         String                    @map("updated_by") @db.Uuid

  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  vehicle             Vehicle?                 @relation(fields: [vehicleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  driver              Driver?                  @relation(fields: [driverId, organizationId], references: [id, organizationId], onDelete: Restrict)
  trip                Trip?                    @relation(fields: [tripId, organizationId], references: [id, organizationId], onDelete: Restrict)
  assignment          VehicleDriverAssignment? @relation(fields: [assignmentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdByUser       User                     @relation("IncidentCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser       User                     @relation("IncidentUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  statusHistory       IncidentStatusHistory[]
  notes               IncidentNote[]
  attachments         IncidentAttachment[]
  maintenanceRequests MaintenanceRequest[]     @relation("IncidentMaintenanceRequests")

  @@unique([organizationId, displayId])
  @@unique([id, organizationId])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, status, createdAt(sort: Desc)])
  @@index([organizationId, type, createdAt(sort: Desc)])
  @@index([organizationId, severity, createdAt(sort: Desc)])
  @@index([organizationId, vehicleId, occurredAt(sort: Desc)])
  @@index([organizationId, driverId, occurredAt(sort: Desc)])
  @@index([organizationId, tripId, occurredAt(sort: Desc)])
  @@index([organizationId, status, operationalImpact])
  @@map("incidents")
}

