# Runtime
NODE_ENV=development
LOG_LEVEL=info

# API
API_PORT=3001
API_CORS_ORIGINS=http://localhost:3000

# Development/test authentication adapter only. Replace with OIDC in production.
AUTH_PROVIDER=local
AUTH_ISSUER=vehicle-management-local
AUTH_AUDIENCE=vehicle-management-api
AUTH_LOCAL_SIGNING_KEY=local-only-signing-key-change-before-use-0001

# Web
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# PostgreSQL
POSTGRES_DB=vehicle_management
POSTGRES_USER=vehicle_management
POSTGRES_PASSWORD=local_vehicle_management
DATABASE_URL=postgresql://vehicle_management:local_vehicle_management@localhost:5432/vehicle_management?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# S3-compatible object storage (MinIO in local development)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=vehicle-management
S3_ACCESS_KEY=vehicle_management
S3_SECRET_KEY=local_vehicle_management_secret
S3_FORCE_PATH_STYLE=true
MINIO_ROOT_USER=vehicle_management
MINIO_ROOT_PASSWORD=local_vehicle_management_secret

# OpenTelemetry (disabled unless explicitly enabled)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=vehicle-management
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Transactional outbox worker
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20
OUTBOX_LOCK_TIMEOUT_MS=60000
